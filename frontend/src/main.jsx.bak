import React,{useEffect,useMemo,useState} from 'react';
import {createRoot} from 'react-dom/client';
import {Canvas} from '@react-three/fiber';
import {OrbitControls,Text,Environment,Float} from '@react-three/drei';
import './styles.css';

const API=(import.meta.env.VITE_API_URL||'').replace(/\/$/,'');
const tokenKey='vao_session';
const getToken=()=>localStorage.getItem(tokenKey)||'';
async function api(path,opt={}){const headers={'Content-Type':'application/json',...(opt.headers||{})};const t=getToken();if(t)headers.Authorization=`Bearer ${t}`;const r=await fetch(`${API}${path}`,{...opt,headers});const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'خطا در ارتباط با دفتر');return d}

const rooms=[['management','🧠','مدیریت',[-4,0,-2]],['development','💻','توسعه',[0,0,-2]],['marketing','📢','بازاریابی',[4,0,-2]],['research','🔎','تحقیق',[-4,0,3]],['finance','💰','مالی',[0,0,3]],['design','🎨','طراحی',[4,0,3]],['analytics','📊','تحلیل',[-8,0,0]],['rnd','🧪','R&D',[8,0,0]]];
function Room({agent,pos,active,onClick}){return <group position={pos} onClick={onClick}><mesh position={[0,1.1,0]}><boxGeometry args={[3.2,2.1,2.5]}/><meshStandardMaterial color={active?'#123b48':'#0a1521'} metalness={.7} roughness={.28}/></mesh><mesh position={[0,.05,0]}><boxGeometry args={[3.5,.12,2.8]}/><meshStandardMaterial color="#0c1c2c" emissive={agent?.color||'#123'} emissiveIntensity={active?.35:.08}/></mesh><mesh position={[0,1.25,1.27]}><boxGeometry args={[1.8,.55,.05]}/><meshStandardMaterial color="#061018" emissive={agent?.color||'#2bd'} emissiveIntensity={.35}/></mesh>{agent&&<Float speed={2} rotationIntensity={.1} floatIntensity={.15}><Text position={[0,2.35,0]} fontSize={.16} color="white" anchorX="center">{agent.icon||'🤖'} {agent.name}</Text><mesh position={[0,.9,.2]}><cylinderGeometry args={[.22,.3,.55,18]}/><meshStandardMaterial color={agent.color||'#5ee7ff'} emissive={agent.color||'#5ee7ff'} emissiveIntensity={.5}/></mesh></Float>}<Text position={[0,-.02,1.43]} fontSize={.13} color="#7191a6" anchorX="center">{rooms.find(r=>r[3]===pos)?.[2]||''}</Text></group>}
function Office3D({agents,selected,setSelected}){return <Canvas camera={{position:[0,10,16],fov:46}}><color attach="background" args={['#03060d']}/><ambientLight intensity={1}/><directionalLight position={[0,10,5]} intensity={2}/><pointLight position={[0,5,0]} color="#24d7ff" intensity={18}/><pointLight position={[6,3,4]} color="#7957ff" intensity={10}/><mesh rotation={[-Math.PI/2,0,0]}><planeGeometry args={[22,15]}/><meshStandardMaterial color="#07111d"/></mesh>{rooms.map(([id,icon,name,pos])=>{const a=agents.find(x=>x.department===id)||agents.find(x=>x.role?.toLowerCase().includes(name.toLowerCase()));return <Room key={id} agent={a} pos={pos} active={selected?.id===a?.id} onClick={()=>a&&setSelected(a)}/>})}<OrbitControls enablePan={false} maxPolarAngle={Math.PI/2.05} minDistance={8} maxDistance={22}/><Environment preset="city"/></Canvas>}

function Login({onLogin}){const [password,setPassword]=useState('');const [busy,setBusy]=useState(false);const [err,setErr]=useState('');const submit=async e=>{e.preventDefault();setBusy(true);setErr('');try{const d=await api('/api/auth/login',{method:'POST',body:JSON.stringify({password})});localStorage.setItem(tokenKey,d.token);onLogin(d)}catch(e){setErr(e.message)}finally{setBusy(false)}};return <div className="login"><div className="login-card"><div className="brand-orb">🏢</div><h1>Virtual AI Office</h1><p>شرکت مجازی هوشمند شما</p><form onSubmit={submit}><input autoFocus type="password" placeholder="رمز ورود مدیر" value={password} onChange={e=>setPassword(e.target.value)}/>{err&&<div className="error">{err}</div>}<button className="primary">{busy?'در حال ورود…':'ورود به دفتر'}</button></form><small>رمز اولیه را از Cloudflare Secret با نام ADMIN_PASSWORD تنظیم کنید.</small></div></div>}

function App(){const [auth,setAuth]=useState(!!getToken());const [state,setState]=useState(null);const [tab,setTab]=useState('office');const [selected,setSelected]=useState(null);const [drawer,setDrawer]=useState(false);const load=async()=>{try{const d=await api('/api/state');setState(d);setSelected(s=>d.agents.find(a=>a.id===s?.id)||d.agents[0]||null)}catch(e){if(/401|جلسه/.test(e.message)){localStorage.removeItem(tokenKey);setAuth(false)}}};useEffect(()=>{if(auth){load();const t=setInterval(load,5000);return()=>clearInterval(t)}},[auth]);if(!auth)return <Login onLogin={()=>setAuth(true)}/>;if(!state)return <div className="loading-screen">در حال راه‌اندازی دفتر…</div>;const nav=[['office','🏢','دفتر'],['agents','🤖','Agentها'],['tasks','📋','وظایف'],['projects','📁','پروژه‌ها'],['workflows','⚡','Workflow'],['memory','🧠','حافظه'],['knowledge','📚','دانش'],['analytics','📊','Analytics'],['providers','🔌','Providers'],['logs','🛰️','لاگ‌ها']];return <div className="app"><header><div className="brand"><b>VIRTUAL AI OFFICE</b><span>AI COMPANY OS</span></div><div className="stats"><span>🟢 {state.agents.filter(a=>['online','working','thinking'].includes(a.status)).length}</span><span>🤖 {state.agents.length}</span><span>⚡ {state.tasks.filter(t=>t.status==='running').length}</span><span>🔔 {state.approvals.filter(a=>a.status==='pending').length}</span></div><button className="hamb" onClick={()=>setDrawer(!drawer)}>☰</button></header><div className={`layout ${drawer?'open':''}`}><aside className="sidebar">{nav.map(([k,i,l])=><button className={tab===k?'active':''} onClick={()=>{setTab(k);setDrawer(false)}}>{i}<span>{l}</span></button>)}<button className="logout" onClick={()=>{localStorage.removeItem(tokenKey);setAuth(false)}}>⎋ خروج</button></aside><main className="content">{tab==='office'&&<Office state={state} selected={selected} setSelected={setSelected} go={setTab}/>} {tab==='agents'&&<Agents state={state} setState={setState} selected={selected} setSelected={setSelected}/>} {tab==='tasks'&&<Tasks state={state} reload={load}/>} {tab==='projects'&&<Projects state={state} reload={load}/>} {tab==='workflows'&&<Workflows state={state} reload={load}/>} {tab==='memory'&&<Memory state={state} reload={load}/>} {tab==='knowledge'&&<Knowledge state={state} reload={load}/>} {tab==='analytics'&&<Analytics state={state}/>} {tab==='providers'&&<Providers state={state} reload={load}/>} {tab==='logs'&&<Logs state={state}/>}</main></div><div className="mobile-nav">{nav.slice(0,5).map(([k,i,l])=><button className={tab===k?'active':''} onClick={()=>setTab(k)}><span>{i}</span>{l}</button>)}</div></div>}

function Office({state,selected,setSelected,go}){const [title,setTitle]=useState('');const [desc,setDesc]=useState('');const [busy,setBusy]=useState(false);const run=async()=>{if(!selected)return;setBusy(true);try{await api('/api/agents/'+selected.id+'/run',{method:'POST',body:JSON.stringify({title:title||'وظیفه فوری',description:desc||'وضعیت فعلی شرکت را بررسی کن و اقدامات مهم را انجام بده.'})});setTitle('');setDesc('')}catch(e){alert(e.message)}finally{setBusy(false)}};return <div className="office-page"><section className="office-view"><div className="office-title"><div><h1>دفتر مرکزی</h1><p>مرکز فرماندهی شرکت مجازی</p></div><span className="live">● LIVE</span></div><Office3D agents={state.agents} selected={selected} setSelected={setSelected}/><div className="scene-help">روی کارمند یا اتاق کلیک کن • چرخش و زوم آزاد</div></section><section className="side-stack"><div className="panel employee"><div className="avatar">{selected?.icon||'🤖'}</div><h2>{selected?.name||'انتخاب Agent'}</h2><small>{selected?.role||''}</small><div className="status">● {selected?.status||'idle'}</div><button onClick={()=>go('agents')}>مدیریت Agent</button></div><div className="panel"><h3>⚡ اجرای فوری</h3><input placeholder="عنوان کار" value={title} onChange={e=>setTitle(e.target.value)}/><textarea placeholder="دستور یا هدف…" value={desc} onChange={e=>setDesc(e.target.value)}/><button className="primary" disabled={!selected||busy} onClick={run}>{busy?'در حال اجرا…':'▶ اجرای Agent'}</button></div><div className="panel"><h3>📡 فعالیت زنده</h3>{state.logs.slice(0,7).map(l=><div className="feed"><b>{l.message}</b><small>{new Date(l.created_at).toLocaleTimeString('fa-IR')}</small></div>)}</div></section></div>}

function Agents({state,setState,selected,setSelected}){const blank={name:'Agent جدید',role:'کارمند سفارشی',department:'management',icon:'🤖',color:'#5ee7ff',prompt:'',personality:'حرفه‌ای، دقیق و مسئولیت‌پذیر',responsibilities:[],goals:[],rules:[],forbidden_actions:[],communication_style:'مختصر و نتیجه‌محور',decision_policy:'در محدوده مجوزها تصمیم بگیر.',escalation_policy:'در عملیات حساس از انسان تأیید بگیر.',provider_id:'',model:'',temperature:.4,max_tokens:3000,memory_enabled:1,permissions:['READ_TASKS','CREATE_TASKS','READ_MEMORY','WRITE_MEMORY','DELEGATE_TASK'],enabled:1,schedule:'',status:'online'};const [draft,setDraft]=useState(selected||blank);useEffect(()=>setDraft(selected||blank),[selected]);const save=async()=>{const d=selected?await api('/api/agents/'+selected.id,{method:'PATCH',body:JSON.stringify(draft)}):await api('/api/agents',{method:'POST',body:JSON.stringify(draft)});setSelected(d);setState(s=>({...s,agents:selected?s.agents.map(a=>a.id===d.id?d:a):[...s.agents,d]}))};const create=()=>{setSelected(null);setDraft({...blank})};const perms=['READ_TASKS','CREATE_TASKS','EDIT_TASKS','DELETE_TASKS','READ_FILES','WRITE_FILES','DELETE_FILES','READ_MEMORY','WRITE_MEMORY','USE_WEB','USE_SEARCH','SEND_EMAIL','READ_EMAIL','USE_GITHUB','CREATE_REPORT','DELEGATE_TASK','APPROVE_TASK','EXECUTE_WORKFLOW'];return <div className="page"><div className="page-head"><div><h1>🤖 Agentهای شرکت</h1><p>کارمندهای هوشمند با هویت، حافظه و دسترسی مستقل</p></div><button className="primary" onClick={create}>＋ Agent جدید</button></div><div className="agent-layout"><div className="agent-list">{state.agents.map(a=><button className={draft.id===a.id?'selected':''} onClick={()=>{setSelected(a);setDraft(a)}}><span>{a.icon}</span><div><b>{a.name}</b><small>{a.role}</small></div><em>{a.status}</em></button>)}</div><div className="editor"><h2>{selected?'ویرایش Agent':'ساخت Agent جدید'}</h2><div className="form-grid"><Field label="نام"><input value={draft.name||''} onChange={e=>setDraft({...draft,name:e.target.value})}/></Field><Field label="نقش"><input value={draft.role||''} onChange={e=>setDraft({...draft,role:e.target.value})}/></Field><Field label="دپارتمان"><select value={draft.department||'management'} onChange={e=>setDraft({...draft,department:e.target.value})}>{rooms.map(r=><option value={r[0]}>{r[1]} {r[2]}</option>)}</select></Field><Field label="آیکون"><input value={draft.icon||'🤖'} onChange={e=>setDraft({...draft,icon:e.target.value})}/></Field><Field label="Provider"><select value={draft.provider_id||''} onChange={e=>setDraft({...draft,provider_id:e.target.value})}><option value="">Default</option>{state.providers.map(p=><option value={p.id}>{p.name}</option>)}</select></Field><Field label="Model"><input value={draft.model||''} onChange={e=>setDraft({...draft,model:e.target.value})}/></Field><Field label="Temperature"><input type="number" step=".1" min="0" max="2" value={draft.temperature??.4} onChange={e=>setDraft({...draft,temperature:Number(e.target.value)})}/></Field><Field label="Max Tokens"><input type="number" value={draft.max_tokens||3000} onChange={e=>setDraft({...draft,max_tokens:Number(e.target.value)})}/></Field><Field label="Cron"><input placeholder="0 9 * * *" value={draft.schedule||''} onChange={e=>setDraft({...draft,schedule:e.target.value})}/></Field><Field label="فعال"><select value={draft.enabled?'1':'0'} onChange={e=>setDraft({...draft,enabled:Number(e.target.value)})}><option value="1">فعال</option><option value="0">خاموش</option></select></Field><Field label="شخصیت"><input value={draft.personality||''} onChange={e=>setDraft({...draft,personality:e.target.value})}/></Field><Field label="سبک پاسخ"><input value={draft.communication_style||''} onChange={e=>setDraft({...draft,communication_style:e.target.value})}/></Field><Field full label="System Prompt"><textarea className="prompt" value={draft.prompt||''} onChange={e=>setDraft({...draft,prompt:e.target.value})}/></Field><Field full label="مسئولیت‌ها (هر مورد در یک خط)"><textarea value={(draft.responsibilities||[]).join('\n')} onChange={e=>setDraft({...draft,responsibilities:e.target.value.split('\n').filter(Boolean)})}/></Field><Field full label="اهداف"><textarea value={(draft.goals||[]).join('\n')} onChange={e=>setDraft({...draft,goals:e.target.value.split('\n').filter(Boolean)})}/></Field><Field full label="قوانین"><textarea value={(draft.rules||[]).join('\n')} onChange={e=>setDraft({...draft,rules:e.target.value.split('\n').filter(Boolean)})}/></Field><Field full label="اقدامات ممنوع"><textarea value={(draft.forbidden_actions||[]).join('\n')} onChange={e=>setDraft({...draft,forbidden_actions:e.target.value.split('\n').filter(Boolean)})}/></Field></div><div className="permissions"><b>مجوزهای Agent</b>{perms.map(p=><label><input type="checkbox" checked={(draft.permissions||[]).includes(p)} onChange={e=>setDraft({...draft,permissions:e.target.checked?[...(draft.permissions||[]),p]:(draft.permissions||[]).filter(x=>x!==p)})}/>{p}</label>)}</div><button className="primary save" onClick={save}>💾 ذخیره Agent</button></div></div></div>}
function Field({label,children,full}){return <label className={full?'full':''}><span>{label}</span>{children}</label>}
function Tasks({state,reload}){const [f,setF]=useState({agentId:state.agents[0]?.id||'',title:'',description:'',priority:'normal'});const create=async()=>{if(!f.title)return;await api('/api/tasks',{method:'POST',body:JSON.stringify(f)});setF({...f,title:'',description:''});reload()};return <div className="page"><div className="page-head"><div><h1>📋 مرکز وظایف</h1><p>صف کارها، اجراها و خروجی Agentها</p></div></div><div className="panel create-task"><select value={f.agentId} onChange={e=>setF({...f,agentId:e.target.value})}>{state.agents.map(a=><option value={a.id}>{a.name}</option>)}</select><input placeholder="عنوان وظیفه" value={f.title} onChange={e=>setF({...f,title:e.target.value})}/><textarea placeholder="شرح" value={f.description} onChange={e=>setF({...f,description:e.target.value})}/><select value={f.priority} onChange={e=>setF({...f,priority:e.target.value})}><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option></select><button className="primary" onClick={create}>＋ ساخت Task</button></div><div className="cards-list">{state.tasks.map(t=><div className="task-card"><div><b>{t.title}</b><small>{state.agents.find(a=>a.id===t.agent_id)?.name||'Agent'}</small></div><span className={`badge ${t.status}`}>{t.status}</span><p>{t.result||t.error||t.description}</p><small>{t.created_at&&new Date(t.created_at).toLocaleString('fa-IR')}</small></div>)}</div></div>}
function Projects({state,reload}){const [name,setName]=useState('');const add=async()=>{if(!name)return;await api('/api/projects',{method:'POST',body:JSON.stringify({name})});setName('');reload()};return <div className="page"><div className="page-head"><div><h1>📁 پروژه‌ها</h1><p>پروژه‌های شرکت و تیم‌های مرتبط</p></div></div><div className="inline-create"><input placeholder="نام پروژه" value={name} onChange={e=>setName(e.target.value)}/><button className="primary" onClick={add}>ساخت پروژه</button></div><div className="cards-list">{state.projects.map(p=><div className="task-card"><b>{p.name}</b><small>{p.status} • پیشرفت {p.progress||0}%</small><p>{p.description||'پروژه جدید شرکت'}</p></div>)}</div></div>}
function Workflows({state,reload}){const [name,setName]=useState('');const add=async()=>{if(!name)return;await api('/api/workflows',{method:'POST',body:JSON.stringify({name,nodes:[{type:'trigger',label:'شروع'},{type:'agent',label:'Agent'},{type:'approval',label:'تأیید انسانی'},{type:'end',label:'پایان'}]})});setName('');reload()};return <div className="page"><div className="page-head"><div><h1>⚡ Workflow Engine</h1><p>زنجیره‌های چندمرحله‌ای Agentها</p></div></div><div className="panel"><input placeholder="نام Workflow" value={name} onChange={e=>setName(e.target.value)}/><button className="primary" onClick={add}>＋ ساخت Workflow</button></div>{state.workflows.map(w=><div className="workflow"><b>{w.name}</b><div className="flow">{(w.nodes||[]).map(n=><span>{n.label||n.type}</span>)}</div></div>)}</div>}
function Memory({state,reload}){const [f,setF]=useState({agentId:state.agents[0]?.id||'',content:'',type:'long_term'});const add=async()=>{if(!f.content)return;await api('/api/memory',{method:'POST',body:JSON.stringify(f)});setF({...f,content:''});reload()};return <div className="page"><div className="page-head"><div><h1>🧠 Memory</h1><p>حافظه واقعی Agentها و شرکت</p></div></div><div className="panel"><select value={f.agentId} onChange={e=>setF({...f,agentId:e.target.value})}>{state.agents.map(a=><option value={a.id}>{a.name}</option>)}</select><textarea placeholder="دانش یا حافظه…" value={f.content} onChange={e=>setF({...f,content:e.target.value})}/><button className="primary" onClick={add}>＋ ذخیره Memory</button></div>{state.memories.map(m=><div className="memory"><b>{state.agents.find(a=>a.id===m.agent_id)?.name||'Company'}</b><span>{m.type}</span><p>{m.content}</p></div>)}</div>}
function Knowledge({state,reload}){const [name,setName]=useState('');const add=async()=>{if(!name)return;await api('/api/knowledge',{method:'POST',body:JSON.stringify({name})});setName('');reload()};return <div className="page"><div className="page-head"><div><h1>📚 Company Knowledge</h1><p>پایگاه دانش شرکت؛ فایل واقعی را می‌توان به R2 متصل کرد.</p></div></div><div className="inline-create"><input placeholder="عنوان سند" value={name} onChange={e=>setName(e.target.value)}/><button className="primary" onClick={add}>ثبت سند</button></div>{state.knowledge.map(k=><div className="memory"><b>{k.name}</b><span>{k.status}</span><p>{k.mime_type||'سند دانش شرکت'}</p></div>)}</div>}
function Analytics({state}){const done=state.tasks.filter(t=>t.status==='completed').length,failed=state.tasks.filter(t=>t.status==='failed').length;return <div className="page"><div className="page-head"><div><h1>📊 Analytics</h1><p>وضعیت عملیاتی شرکت</p></div></div><div className="metric-grid"><Metric n={state.agents.length} l="Agentها"/><Metric n={state.tasks.length} l="کل Taskها"/><Metric n={done} l="موفق"/><Metric n={failed} l="خطا"/><Metric n={state.approvals.filter(a=>a.status==='pending').length} l="نیازمند تأیید"/><Metric n={state.runs.length} l="Execution"/></div><div className="panel"><h3>سلامت سیستم</h3><div className="health">Worker API <b>ONLINE</b></div><div className="health">Agent Runtime <b>READY</b></div><div className="health">Database <b>D1</b></div><div className="health">Queue <b>CONFIGURABLE</b></div></div></div>}
function Metric({n,l}){return <div className="metric"><b>{n}</b><span>{l}</span></div>}
function Providers({state,reload}){const [f,setF]=useState({name:'OpenAI-Compatible',base_url:'https://api.openai.com/v1',model:'',api_key:''});const add=async()=>{await api('/api/providers',{method:'POST',body:JSON.stringify(f)});setF({...f,api_key:'',name:'Provider جدید'});reload()};return <div className="page"><div className="page-head"><div><h1>🔌 AI Providers</h1><p>کلیدها فقط در Backend و به‌صورت رمزنگاری‌شده نگهداری می‌شوند.</p></div></div><div className="form-grid panel"><Field label="نام"><input value={f.name} onChange={e=>setF({...f,name:e.target.value})}/></Field><Field label="Base URL"><input value={f.base_url} onChange={e=>setF({...f,base_url:e.target.value})}/></Field><Field label="Model"><input value={f.model} onChange={e=>setF({...f,model:e.target.value})}/></Field><Field label="API Key"><input type="password" value={f.api_key} onChange={e=>setF({...f,api_key:e.target.value})}/></Field><button className="primary full" onClick={add}>＋ افزودن Provider</button></div>{state.providers.map(p=><div className="provider"><b>{p.name}</b><span>{p.base_url}</span><span>{p.model||'مدل از Agent'}</span><em>🔐 Secret</em></div>)}</div>}
function Logs({state}){return <div className="page"><div className="page-head"><div><h1>🛰️ Audit & Execution Logs</h1><p>ردیابی فعالیت‌ها و خطاهای Agentها</p></div></div><div className="cards-list">{state.logs.map(l=><div className="log-card"><b>{l.action||l.type}</b><span>{l.agent_id||''}</span><small>{l.created_at&&new Date(l.created_at).toLocaleString('fa-IR')}</small><p>{l.message||l.error||''}</p></div>)}</div></div>}

createRoot(document.getElementById('root')).render(<App/>);
